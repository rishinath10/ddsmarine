# Copy this file to .env for local development (.env is gitignored).
# In production (Dokploy), set these under the app's Environment Variables
# settings instead — do not commit real values to git.

# Required: API key from https://resend.com/api-keys (Resend dashboard).
RESEND_API_KEY=

# Optional: overrides where contact-form leads are sent. Defaults to
# info@ddsmarine.com if unset.
LEAD_TO_EMAIL=info@ddsmarine.com

# Optional: overrides the "From" address used when sending lead emails.
# Until ddsmarine.com is verified as a sending domain in Resend, this MUST
# stay on the onboarding@resend.dev address below (Resend rejects any other
# From address from an unverified domain). Once you verify ddsmarine.com in
# the Resend dashboard, change this to something like:
#   DDS Marine Website <website@ddsmarine.com>
RESEND_FROM=DDS Marine Website <onboarding@resend.dev>

<%- include('partials/head') %>
<%- include('partials/header') %>

  <main>
    <!-- Hero Section -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 bg-navy-gradient overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 50%, #C9A24B 0%, transparent 50%);"></div>
      <div class="container mx-auto px-4 lg:px-8 text-center relative z-10">
        <div class="reveal">
          <% if (locals.post) { %>
            <!-- Single Post View -->
            <a href="/blog" class="inline-flex items-center gap-2 text-gold-light hover:text-gold transition-colors mb-6 text-sm font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              Back to Blog
            </a>
            <span class="text-gold text-sm font-medium tracking-widest uppercase"><%= post.date %></span>
            <h1 class="text-3xl md:text-5xl font-heading font-bold text-ivory mt-3 max-w-3xl mx-auto leading-tight"><%= post.title %></h1>
            <p class="text-ivory/60 mt-3 text-sm">By <%= post.author %></p>
            <% if (post.tags && post.tags.length) { %>
              <div class="flex flex-wrap justify-center gap-2 mt-4">
                <% post.tags.forEach(function(tag) { %>
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-gold/20 text-gold-light"><%= tag %></span>
                <% }); %>
              </div>
            <% } %>
          <% } else { %>
            <!-- Blog Archive View -->
            <span class="text-gold text-sm font-medium tracking-widest uppercase">Our Blog</span>
            <h1 class="text-3xl md:text-5xl font-heading font-bold text-ivory mt-3">DDS Marine Insights</h1>
            <p class="text-ivory/60 mt-4 max-w-2xl mx-auto">Industry insights, company updates, and technical knowledge from the DDS Marine team.</p>
          <% } %>
        </div>
      </div>
    </section>

    <% if (!locals.post) { %>
      <!-- Blog List -->
      <section class="py-16 lg:py-24 bg-ivory">
        <div class="container mx-auto px-4 lg:px-8">
          <% if (posts.length === 0) { %>
            <div class="text-center py-16">
              <p class="text-navy/50 text-lg">No blog posts yet. Check back soon!</p>
            </div>
          <% } else { %>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              <% posts.forEach(function(post) { %>
                <article class="reveal bg-white rounded-2xl overflow-hidden shadow-elegant border border-slate-200/60 card-lift">
                  <div class="p-8">
                    <div class="flex items-center gap-3 text-xs text-navy/40 mb-3">
                      <span><%= post.date %></span>
                      <% if (post.tags && post.tags.length) { %>
                        <span class="w-1 h-1 rounded-full bg-navy/20"></span>
                        <span><%= post.tags[0] %></span>
                      <% } %>
                    </div>
                    <h2 class="text-xl font-heading font-semibold text-navy mb-3">
                      <a href="/blog/<%= post.slug %>" class="hover:text-gold-dark transition-colors"><%= post.title %></a>
                    </h2>
                    <p class="text-navy/60 text-sm leading-relaxed mb-4"><%= post.excerpt %></p>
                    <a href="/blog/<%= post.slug %>" class="inline-flex items-center gap-1 text-gold-dark font-medium text-sm hover:text-gold transition-colors">
                      Read More
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </div>
      </section>
    <% } else { %>
      <!-- Single Post Content -->
      <article class="py-16 lg:py-24 bg-ivory">
        <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
          <div class="reveal prose prose-lg prose-headings:font-heading prose-headings:text-navy prose-p:text-navy/70 prose-a:text-gold-dark prose-a:no-underline hover:prose-a:text-gold prose-strong:text-navy prose-li:text-navy/70 max-w-none">
            <%- post.content %>
          </div>
          <div class="mt-12 pt-8 border-t border-slate-200">
            <a href="/blog" class="inline-flex items-center gap-2 text-navy/50 hover:text-navy transition-colors text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              Back to all posts
            </a>
          </div>
        </div>
      </article>
    <% } %>
  </main>

  <%- include('partials/footer') %>

<body x-data="{ mobileOpen: false, navScrolled: false }" @scroll.window="navScrolled = (window.scrollY > 60)">

  <div id="preloader" aria-hidden="true">
    <div class="loader-mark">
      <img src="/assets/dds-logo-transparent.png" alt="DDS Marine" class="loader-logo" width="130" height="130" />
      <div class="loader-brand mt-4">DDS Marine</div>
    </div>
  </div>
  <script>
    if (sessionStorage.getItem('preloader_shown')) {
      document.getElementById('preloader').style.display = 'none';
    } else {
      sessionStorage.setItem('preloader_shown', 'true');
    }
  </script>

  <%
    var navLinks = [
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about' },
      { label: 'Services', href: '/services' },
      { label: 'Partners', href: '/partners' },
      { label: 'Projects', href: '/projects' },
      { label: 'Team', href: '/team' },
      { label: 'Blog', href: '/blog' },
      { label: 'Intelligence', href: '/intelligence' },
      { label: 'Contact', href: '/contact' }
    ];
    var currentPath = locals.path || '/';
    function isActive(href) {
      if (href === '/') return currentPath === '/';
      return currentPath === href || currentPath.indexOf(href + '/') === 0;
    }
  %>
  <header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="container mx-auto px-3 lg:px-6 py-2.5 lg:py-3">
      <div class="flex items-center justify-between rounded-xl px-4 lg:px-5 h-14 lg:h-16 transition-all duration-300 border"
        :class="navScrolled
          ? 'bg-navy/80 backdrop-blur-xl border-white/15 shadow-[0_8px_32px_rgba(0,0,0,0.3)]'
          : 'bg-white/10 backdrop-blur-lg border-white/20 shadow-[0_8px_32px_rgba(0,0,0,0.15)]'">
        <a href="/" class="flex items-center gap-2.5 shrink-0">
          <img src="/assets/dds-logo-transparent.png" alt="DDS Marine" class="h-9 w-auto" width="36" height="36" />
          <span class="font-heading text-sm font-bold tracking-tight leading-none hidden sm:block text-ivory drop-shadow-sm">DDS MARINE ENERGY SERVICES</span>
        </a>
        <nav class="hidden lg:flex items-center gap-0.5">
          <% navLinks.forEach(function(link) { %>
            <a href="<%= link.href %>"
              class="relative text-[13px] font-heading font-medium uppercase tracking-[0.06em] px-2.5 py-1.5 rounded-lg transition-all duration-200 <%= isActive(link.href) ? 'text-gold bg-white/10' : 'text-ivory/85 hover:text-gold hover:bg-white/10' %>">
              <%= link.label %>
            </a>
          <% }); %>
        </nav>
        <button @click="mobileOpen = !mobileOpen" class="lg:hidden text-ivory p-2" aria-label="Toggle menu">
          <span x-show="!mobileOpen"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
              <line x1="4" x2="20" y1="12" y2="12" />
              <line x1="4" x2="20" y1="6" y2="6" />
              <line x1="4" x2="20" y1="18" y2="18" />
            </svg></span>
          <span x-show="mobileOpen" x-cloak><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
              <path d="M18 6 6 18" />
              <path d="m6 6 12 12" />
            </svg></span>
        </button>
      </div>
      <!-- Mobile dropdown -->
      <div x-show="mobileOpen" x-cloak x-transition
        class="lg:hidden mt-2 rounded-xl bg-navy border border-white/20 shadow-[0_8px_32px_rgba(0,0,0,0.5)] overflow-hidden">
        <nav class="flex flex-col p-2">
          <% navLinks.forEach(function(link) { %>
            <a href="<%= link.href %>"
              class="px-4 py-3 text-base font-heading font-semibold uppercase tracking-[0.04em] rounded-lg transition-colors <%= isActive(link.href) ? 'text-gold bg-white/10' : 'text-white hover:text-gold hover:bg-white/5' %>"><%= link.label %></a>
          <% }); %>
        </nav>
      </div>
    </div>
  </header>
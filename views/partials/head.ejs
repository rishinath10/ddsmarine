  {
    "@context": "https://schema.org",
    "@type": "MaritimeOrganization",
    "@id": "https://www.ddsmarine.com/#organization",
    "name": "DDS Marine Energy Services",
    "legalName": "DDS Marine Energy Services Sdn. Bhd.",
    "alternateName": "DDS Marine",
    "url": "https://www.ddsmarine.com/",
    "logo": "https://www.ddsmarine.com/assets/dds-logo-transparent.png",
    "image": "https://www.ddsmarine.com/assets/hero-ship.jpg",
    "description": "DDS Marine Energy Services provides STS operations, deep-draft pilotage, bunkering, chartering and marine advisory from Penang across the Straits of Malacca.",
    "foundingDate": "2020",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "3J-13-1 Straits Quay, Jalan Seri Tanjung Pinang, Tanjung Tokong",
      "postalCode": "10470",
      "addressLocality": "Pulau Pinang",
      "addressCountry": "MY"
    },
    "telephone": "+60165063003",
    "email": "info@ddsmarine.com",
    "sameAs": [
      "https://www.linkedin.com/company/dds-marine-energy",
      "https://wa.me/60165063003"
    ],
    "areaServed": ["Malaysia", "Singapore", "Indonesia", "Hong Kong", "India", "United Arab Emirates"],
    "knowsAbout": ["Ship-to-Ship Transfer", "Deep Draft Pilotage", "Marine Bunkering", "Vessel Chartering", "Marine Advisory", "Mooring Master Services"]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
    rel="stylesheet">
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            heading: ['Jost', 'ui-sans-serif', 'system-ui', 'sans-serif'],
            body: ['"EB Garamond"', 'Georgia', 'serif'],
            bebas: ['"Bebas Neue"', 'sans-serif'],
          },
          colors: {
            gold: { DEFAULT: '#C8973F', light: '#DFC48A', dark: '#A87A2E' },
            navy: { DEFAULT: '#0E2240', deep: '#081527' },
            ivory: '#F7F3EA',
            hairline: '#D9C48F',
            ink: '#1C2B3A',
          },
          boxShadow: {
            gold: '0 12px 40px -12px rgba(201,162,75,0.45)',
            elegant: '0 20px 50px -20px rgba(11,20,34,0.25)',
          },
          backgroundImage: {
            'gold-gradient': 'linear-gradient(135deg,#B8862F 0%,#C9A24B 35%,#E8D58A 65%,#B8862F 100%)',
            'navy-gradient': 'linear-gradient(180deg,#1B2A45 0%,#0E1A2D 100%)',
            'cream-gradient': 'linear-gradient(135deg,#FAF6ED 0%,#EFE5CE 100%)',
          },
          animation: {
            'marquee': 'marquee 35s linear infinite',
            'float': 'float 6s ease-in-out infinite',
          },
          keyframes: {
            marquee: { from: { transform: 'translateX(0)' }, to: { transform: 'translateX(-50%)' } },
            float: { '0%,100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-12px)' } },
          },
        },
      },
    }
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <style>
    html {
      background: #F8F4EC;
      overscroll-behavior-y: none;
    }

    body {
      font-family: 'EB Garamond', Georgia, serif;
      font-weight: 500;
      background: #F8F4EC;
      color: #152238;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overscroll-behavior-y: none;
      min-height: 100vh;
      min-height: 100dvh;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      font-family: 'Jost', sans-serif;
      letter-spacing: -0.02em;
      font-weight: 600;
    }

    .text-gold-gradient {
      background: linear-gradient(135deg, #B8862F 0%, #C9A24B 35%, #E8D58A 65%, #B8862F 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    [x-cloak] {
      display: none !important;
    }

    html {
      scroll-behavior: smooth;
    }

    img {
      image-rendering: auto;
    }

    .photo-crisp {
      /* Filters removed to prevent rasterization layer downsampling */
    }

    .hero-media {
      /* Animations and scaling removed for maximum sharpness */
    }

    .reveal {
      opacity: 0;
      transform: translate3d(0, 22px, 0);
      transition: opacity .7s cubic-bezier(.16,.8,.24,1), transform .7s cubic-bezier(.16,.8,.24,1);
      transition-delay: var(--reveal-delay, 0ms);
      will-change: opacity, transform;
    }

    .reveal.in {
      opacity: 1;
      transform: none;
    }

    .reveal-left {
      transform: translate3d(-36px, 0, 0);
    }

    .reveal-right {
      transform: translate3d(36px, 0, 0);
    }

    .reveal-scale {
      transform: translate3d(0, 16px, 0) scale(.94);
    }

    .reveal-scale.in {
      transform: none;
    }

    .float-soft {
      animation: float 7s ease-in-out infinite;
    }

    .card-lift {
      transition: box-shadow .2s cubic-bezier(.2,.7,.3,1), border-color .2s cubic-bezier(.2,.7,.3,1);
    }

    .card-lift:hover {
      box-shadow: 0 4px 16px rgba(14, 34, 64, .12);
    }

    #preloader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: grid;
      place-items: center;
      background: #F8F4EC;
      color: #152238;
      transition: opacity .55s ease, visibility .55s ease;
    }

    #preloader.preloader-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .loader-mark {
      display: grid;
      place-items: center;
      gap: 1.15rem;
      text-align: center;
    }

    .loader-ring {
      width: 70px;
      height: 70px;
      border-radius: 9999px;
      border: 1px solid rgba(232, 213, 138, .28);
      border-top-color: #E8D58A;
      animation: spin 1s linear infinite;
      box-shadow: 0 0 45px rgba(201, 162, 75, .18);
    }

    .loader-brand {
      font-family: 'Jost', sans-serif;
      font-size: .72rem;
      letter-spacing: .34em;
      text-transform: uppercase;
      color: #152238;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }


    .animate-marquee-slow {
      animation: marquee-slow 28s linear infinite;
    }

    @keyframes marquee-slow {
      from {
        transform: translate3d(0, 0, 0);
      }

      to {
        transform: translate3d(-50%, 0, 0);
      }
    }

    .loader-logo {
      width: 130px;
      height: 130px;
      object-fit: contain;
      animation: logo-pulse 2s ease-in-out infinite;
    }

    @keyframes logo-pulse {

      0%,
      100% {
        transform: scale(0.92);
        opacity: 0.75;
      }

      50% {
        transform: scale(1.04);
        opacity: 1;
      }
    }

    @keyframes hero-kenburns {
      0% { transform: scale(1) translate3d(0,0,0); }
      100% { transform: scale(1.08) translate3d(-1%, -1%, 0); }
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }

      .reveal,
      .reveal-left,
      .reveal-right,
      .reveal-scale {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }

      #preloader {
        display: none !important;
      }
    }
  </style>
  <noscript>
    <style>
      .reveal {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important
      }

      #preloader {
        display: none !important
      }
    </style>
  </noscript>
</head>
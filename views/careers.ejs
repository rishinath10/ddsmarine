<%- include('partials/head') %>
<%- include('partials/header') %>

  <main>
    <!-- Hero Section -->
    <section class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 bg-navy-gradient overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 50%, #C9A24B 0%, transparent 50%);"></div>
      <div class="container mx-auto px-4 lg:px-8 text-center relative z-10">
        <div class="reveal">
          <% if (locals.posting) { %>
            <!-- Single Posting View -->
            <a href="/careers" class="inline-flex items-center gap-2 text-gold-light hover:text-gold transition-colors mb-6 text-sm font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              Back to Careers
            </a>
            <span class="text-gold text-sm font-medium tracking-widest uppercase"><%= posting.department %></span>
            <h1 class="text-3xl md:text-5xl font-heading font-bold text-ivory mt-3 max-w-3xl mx-auto leading-tight"><%= posting.title %></h1>
            <div class="flex flex-wrap justify-center gap-2 mt-5">
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-gold/20 text-gold-light"><%= posting.location %></span>
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-gold/20 text-gold-light"><%= posting.type %></span>
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-white/10 text-ivory/70">Posted <%= posting.date %></span>
            </div>
          <% } else { %>
            <!-- Careers Archive View -->
            <span class="text-gold text-sm font-medium tracking-widest uppercase">Join Our Team</span>
            <h1 class="text-3xl md:text-5xl font-heading font-bold text-ivory mt-3">Careers at DDS Marine</h1>
            <p class="text-ivory/60 mt-4 max-w-2xl mx-auto">We're always looking for experienced mariners, operators and advisors who share our commitment to safety and excellence. Explore our current openings below.</p>
          <% } %>
        </div>
      </div>
    </section>

    <% if (!locals.posting) { %>
      <!-- Careers List -->
      <section class="py-16 lg:py-24 bg-ivory">
        <div class="container mx-auto px-4 lg:px-8">
          <% if (postings.length === 0) { %>
            <div class="text-center py-16">
              <p class="text-navy/50 text-lg">No open positions right now. Check back soon, or reach out &mdash; we're always glad to hear from strong candidates.</p>
              <a href="/contact" class="mt-6 inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gold-gradient text-navy-deep font-heading font-semibold shadow-gold hover:scale-[1.02] transition-transform">
                Get in Touch
              </a>
            </div>
          <% } else { %>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              <% postings.forEach(function(posting) { %>
                <article class="reveal bg-white rounded-2xl overflow-hidden shadow-elegant border border-slate-200/60 card-lift">
                  <div class="p-8">
                    <div class="flex items-center gap-3 text-xs text-navy/40 mb-3">
                      <span><%= posting.department %></span>
                      <span class="w-1 h-1 rounded-full bg-navy/20"></span>
                      <span><%= posting.location %></span>
                    </div>
                    <h2 class="text-xl font-heading font-semibold text-navy mb-3">
                      <a href="/careers/<%= posting.slug %>" class="hover:text-gold-dark transition-colors"><%= posting.title %></a>
                    </h2>
                    <p class="text-navy/60 text-sm leading-relaxed mb-4"><%= posting.excerpt %></p>
                    <div class="flex items-center justify-between">
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-heading font-bold uppercase tracking-wide bg-gold/10 text-gold-dark"><%= posting.type %></span>
                      <a href="/careers/<%= posting.slug %>" class="inline-flex items-center gap-1 text-gold-dark font-medium text-sm hover:text-gold transition-colors">
                        View Role
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                      </a>
                    </div>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </div>
      </section>
    <% } else { %>
      <!-- Single Posting Content -->
      <article class="py-16 lg:py-24 bg-ivory">
        <div class="container mx-auto px-4 lg:px-8 max-w-3xl">
          <div class="reveal prose prose-lg prose-headings:font-heading prose-headings:text-navy prose-p:text-navy/70 prose-a:text-gold-dark prose-a:no-underline hover:prose-a:text-gold prose-strong:text-navy prose-li:text-navy/70 max-w-none">
            <%- posting.description %>
          </div>

          <div class="mt-12 p-8 rounded-2xl bg-navy border-t-4 border-gold flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
            <div>
              <p class="font-heading text-lg font-bold text-ivory">Interested in this role?</p>
              <p class="text-sm text-ivory/60 mt-1">Send your CV together with your current/expected salary and availability to <%= posting.applyEmail || 'info@ddsmarine.com' %>, quoting &ldquo;<%= posting.title %>&rdquo; in the subject line.</p>
            </div>
            <a href="mailto:<%= posting.applyEmail || 'info@ddsmarine.com' %>?subject=<%= encodeURIComponent('Application: ' + posting.title) %>"
              class="shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded bg-gold text-navy font-heading font-bold text-sm hover:bg-gold-dark transition-colors">
              Apply Now
            </a>
          </div>

          <div class="mt-8">
            <a href="/careers" class="inline-flex items-center gap-2 text-navy/50 hover:text-navy transition-colors text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              Back to all openings
            </a>
          </div>
        </div>
      </article>
    <% } %>
  </main>

  <%- include('partials/footer') %>
